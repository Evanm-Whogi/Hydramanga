discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=mangascrolls"]
  }
}

discovery.relabel "app_containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "server|worker"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "app" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.app_containers.output
  forward_to = [loki.process.json_logs.receiver]
  labels     = {
    job = "docker",
  }
}

loki.process "json_logs" {
  forward_to = [loki.write.default.receiver]

  stage.docker {}

  stage.json {
    expressions = {
      level   = "level",
      service = "service",
      type    = "type",
      msg     = "message",
    }
  }

  stage.labels {
    values = {
      level   = "level",
      service = "service",
      type    = "type",
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
