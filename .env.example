# Root .env — compose-level interpolation ONLY (gitignored; matched by .gitignore
# 'docker-compose.*'? No — this is `.env`). Holds Postgres creds, the dev Mullvad
# VPN config, and archive toggles. Prod uses a different .env (no vpn profile).

# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Cloudflared tunnel credentials file
CLOUDFLARED_TUNNEL_CREDS=/root/.cloudflared/<id>.json

# Archive ingestion ---
ARCHIVE_INGEST_ENABLED=true
ARCHIVE_VPN_REQUIRED=false
ARCHIVE_INGEST_CONCURRENCY=2
# QBITTORRENT_NETWORK_MODE=service:gluetun
# QBITTORRENT_URL=http://gluetun:8080
# GLUETUN_CONTROL_URL=http://gluetun:8000

# Qbittorrent
QBITTORRENT_URL=http://qbittorrent:8080

# VPN
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
MULLVAD_WIREGUARD_PRIVATE_KEY=
MULLVAD_WIREGUARD_ADDRESSES=
MULLVAD_SERVER_COUNTRIES=
MULLVAD_SERVER_CITIES=

# Worker compute
# libuv thread pool for the worker (sharp transcode + async I/O). ~1.5x the worker
# cpu limit in docker-compose.yml. Raise alongside the cpu limit, lower if it's noisy.
UV_THREADPOOL_SIZE=32

# Scraper
# Activate ONLY the scraper-egress gluetun (not the archive/torrent `vpn` gluetun).
COMPOSE_PROFILES=scraper-vpn
SCRAPER_PROXY_ENABLED=true
SCRAPER_PROXY_URL=http://gluetun-scraper:8888
# Comma-separated scraper ids that egress directly even when the proxy is on.
# Kagane blocks datacenter IPs; Onisaga cf_clearance from FlareSolverr is bound to the solver's IP.
SCRAPER_PROXY_DISABLED=onisaga,toonily
# Proxy-agent socket pool. The agent keepAlives + reuses the VPN CONNECT tunnel across
# image fetches; raise these if the tunnel has bandwidth headroom, lower if the exit chokes.
SCRAPER_PROXY_MAX_SOCKETS=256
SCRAPER_PROXY_MAX_FREE_SOCKETS=32
SCRAPER_GLUETUN_CONTROL_URL=http://gluetun-scraper:8000

# Bind Loki/Prometheus
OBSERVABILITY_BIND=
