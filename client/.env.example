NEXT_PUBLIC_NAME=
NEXT_PUBLIC_DESC=
NEXT_PUBLIC_SLOGAN=
NEXT_PUBLIC_URL=
NEXT_PUBLIC_DISCORD=
PUBLIC_VERSION=B-1.5

# Backend API origin used by Next rewrites and server-side calls
# In Docker, compose sets this to http://server:4000
BACKEND_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=https://<domain>/api

# Auth
BETTER_AUTH_SECRET=

# Set to "true" to enable DevTools blocking (see public/devtools-guard.js)
NEXT_PUBLIC_BLOCK_DEVTOOLS=false
