NEXT_PUBLIC_NAME=Manga Scrolls
NEXT_PUBLIC_DESC=Your ultimate destination for manga. Discover, read, and share thousands of titles from your favorite genres.
NEXT_PUBLIC_SLOGAN=Read. Enjoy. Repeat.
NEXT_PUBLIC_URL=https://manga.chit.sh

# Backend API origin used by Next rewrites and server-side calls
# In Docker, compose sets this to http://server:4000
BACKEND_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=https://manga.chit.sh/api

# Auth
BETTER_AUTH_SECRET=
# (legacy) NEXT_PUBLIC_AUTH_URL is not required with rewrites; kept for compatibility
NEXT_PUBLIC_AUTH_URL=http://localhost:3000/api

# Set to "false" to disable DevTools blocking (see public/devtools-guard.js)
# NEXT_PUBLIC_BLOCK_DEVTOOLS=false
