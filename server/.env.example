# Public Site Configuration
PUBLIC_NAME=HydraManga
PUBLIC_DESC=HydraManga gives you total control over how you discover and read. Earn badges, climb the leaderboards, and join a community that never sleeps. Are you ready to read?
PUBLIC_SLOGAN=Unleash your next Obsession.
# Site version prefix: A=alpha, B=beta (used for legacy badges and footer display)
PUBLIC_VERSION=B-1.00
PORT=4000 # Backend Port

# Notifications (set ENABLE_DISCORD_NOTIFICATIONS=true to send)
ENABLE_DISCORD_NOTIFICATIONS=false
DISCORD_PUBLIC_WEBHOOK_URL=
DISCORD_ADMIN_WEBHOOK_URL=
# Legacy fallback — used for both channels if the URLs above are unset
DISCORD_WEBHOOK_URL=

# Database Configuration
DATABASE_URL=
# Max Postgres connections per server/worker process (default 20)
DB_POOL_MAX=20

# Authentication Configuration
# Comma-separated emails promoted to admin on registration (optional; no auto first-user admin)
BOOTSTRAP_ADMIN_EMAILS=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001 # This MUST be the backend's own URL
BETTER_AUTH_SECURE_COOKIES=true # Set to true in production with HTTPS

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Other queues
CHAPTER_SCAN_CONCURRENCY=2              # How many mangas to scan for new chapters at once
STORAGE_CLEANUP_CONCURRENCY=1           # Background chapter file deletion jobs

# Scan 
TRENDING_SCAN_SCHEDULE=0 2,14 * * *  # Every day at 2 AM and 2 PM
MONITORED_SCAN_SCHEDULE=0 2,14 * * * # Every day at 2 AM and 2 PM
TRENDING_LIMIT=25 # How many mangas to consider for trending fetching

# Optional
ENABLE_IMPORT_CRON=false # Set to true to enable the manga import cron job

# Temp for dev
PUBLIC_APP_URL=https://domain

# NSFW Content Filter Set to false to filter out adult/NSFW content
ALLOW_NSFW_CONTENT=true

# Blocked Genres (comma-separated, case-insensitive)
BLOCKED_GENRES=Hentai,Lolicon,Shotacon,Erotica,Smut

# Queue Concurrency
# Each scraper has its own chapter download queue (chapterDownload-{scraperId}).
# Per-scraper vars override the defaults below; unset scrapers inherit CHAPTER_DOWNLOAD_CONCURRENCY / CHAPTER_DOWNLOAD_RATE_MAX.
# Shared chapter download defaults
CHAPTER_DOWNLOAD_CONCURRENCY=4          # Fallback when a scraper-specific value is not set
CHAPTER_DOWNLOAD_RATE_MAX=4             # Max jobs started per rate window (global fallback)
CHAPTER_DOWNLOAD_RATE_DURATION=1000     # Rate window in ms
CHAPTER_DOWNLOAD_TIMEOUT=900000         # 15 minutes per chapter job
CHAPTER_DOWNLOAD_RETRIES=2              # How many times to retry a job if it fails
CHAPTER_PREVIEW_COUNT=10                # Preview chapters queued first on initial scan

# Scraper Configuration
WEEB_CENTRAL_ENABLED=true
WEEB_CENTRAL_PRIORITY=1
WEEB_CENTRAL_TIMEOUT=30000
CHAPTER_DOWNLOAD_WEEBCENTRAL_CONCURRENCY=7 # How many chapter jobs to run at once
CHAPTER_DOWNLOAD_WEEBCENTRAL_RATE_MAX=7 # Max jobs started per rate window

ATSU_MOE_ENABLED=true
ATSU_MOE_PRIORITY=2
ATSU_MOE_TIMEOUT=30000
CHAPTER_DOWNLOAD_ATSUMOE_CONCURRENCY=7
CHAPTER_DOWNLOAD_ATSUMOE_RATE_MAX=7

MANGATARO_ENABLED=true
MANGATARO_PRIORITY=3
MANGATARO_TIMEOUT=30000
CHAPTER_DOWNLOAD_MANGATARO_CONCURRENCY=5
CHAPTER_DOWNLOAD_MANGATARO_RATE_MAX=5

COMIX_ENABLED=true
COMIX_PRIORITY=4
COMIX_TIMEOUT=30000
CHAPTER_DOWNLOAD_COMIX_CONCURRENCY=2
CHAPTER_DOWNLOAD_COMIX_RATE_MAX=2

KAGANE_ENABLED=true
KAGANE_PRIORITY=5
KAGANE_TIMEOUT=120000
# Host dev: http://localhost:8191 — Docker worker: http://flaresolverr:8191
KAGANE_FLARESOLVERR_URL=http://localhost:8191
CHAPTER_DOWNLOAD_KAGANE_CONCURRENCY=1
CHAPTER_DOWNLOAD_KAGANE_RATE_MAX=2

TOONILY_ENABLED=true
TOONILY_PRIORITY=6
TOONILY_TIMEOUT=30000
CHAPTER_DOWNLOAD_TOONILY_CONCURRENCY=4
CHAPTER_DOWNLOAD_TOONILY_RATE_MAX=4

ASURA_COMIC_ENABLED=true
ASURA_COMIC_PRIORITY=7
ASURA_COMIC_TIMEOUT=30000
CHAPTER_DOWNLOAD_ASURACOMIC_CONCURRENCY=4
CHAPTER_DOWNLOAD_ASURACOMIC_RATE_MAX=4

MANGADEX_ENABLED=true
MANGADEX_PRIORITY=8
MANGADEX_TIMEOUT=30000
CHAPTER_DOWNLOAD_MANGADEX_CONCURRENCY=2
CHAPTER_DOWNLOAD_MANGADEX_RATE_MAX=2

NHENTAI_ENABLED=true
NHENTAI_PRIORITY=9
NHENTAI_TIMEOUT=30000
CHAPTER_DOWNLOAD_NHENTAI_CONCURRENCY=2
CHAPTER_DOWNLOAD_NHENTAI_RATE_MAX=2

# Monitoring Stack
ENABLE_SENTRY=false
SENTRY_DSN=

# Contact
CONTACT_EMAIL=contact@email.com
LEGAL_EMAIL=dmca@contact.com

# Logs
AUDIT_LOG_RETENTION_DAYS=90

# S3
S3_ACCESS_KEY_ID=KEYHERE
S3_SECRET_ACCESS_KEY=SECRETHERE
# Global cap on concurrent object uploads (PutObject) across all jobs — backpressure so the
# scrape/transcode pipeline can't flood Garage. Lower if you see Garage 503s/timeouts in worker logs.
S3_MAX_CONCURRENT_UPLOADS=48
# S3 client socket-pool size. Keep above S3_MAX_CONCURRENT_UPLOADS so reads/heads aren't starved behind uploads.
S3_MAX_SOCKETS=80