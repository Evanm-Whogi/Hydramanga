# Public Site Configuration
PUBLIC_NAME=Manga Scrolls
PUBLIC_DESC=Your ultimate destination for manga. Discover, read, and share thousands of titles from your favorite genres.
PUBLIC_SLOGAN=Read. Enjoy. Repeat.
PORT=4000 # Backend Port

# Notifications (set ENABLE_DISCORD_NOTIFICATIONS=true to send)
ENABLE_DISCORD_NOTIFICATIONS=false
DISCORD_PUBLIC_WEBHOOK_URL=
DISCORD_ADMIN_WEBHOOK_URL=
# Legacy fallback — used for both channels if the URLs above are unset
DISCORD_WEBHOOK_URL=

# Database Configuration
DATABASE_URL=

# Authentication Configuration
# Comma-separated emails promoted to admin on registration (optional; no auto first-user admin)
BOOTSTRAP_ADMIN_EMAILS=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001 # This MUST be the backend's own URL
BETTER_AUTH_SECURE_COOKIES=true # Set to true in production with HTTPS

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Manga Chapter Storage Configuration
CHAPTER_STORAGE_ROOT=/data/manga
MEDIA_BASE_URL=https://domain/media/manga

# Queue Concurrency
CHAPTER_DOWNLOAD_CONCURRENCY=7 # How many chapters to download at once
CHAPTER_SCAN_CONCURRENCY=2 # how many mangas to scan for new chapters at once

# Scan 
TRENDING_SCAN_SCHEDULE=0 2,14 * * *  # Every day at 2 AM and 2 PM
MONITORED_SCAN_SCHEDULE=0 2,14 * * * # Every day at 2 AM and 2 PM
TRENDING_LIMIT=25 # How many mangas to consider for trending fetching

# Optional
ENABLE_IMPORT_CRON=false # Set to true to enable the manga import cron job

# Temp for dev
PUBLIC_APP_URL=https://domain

# NSFW Content Filter Set to false to filter out adult/NSFW content
ALLOW_NSFW_CONTENT=true

# Blocked Genres (comma-separated, case-insensitive)
BLOCKED_GENRES=Hentai,Lolicon,Shotacon,Erotica,Smut

# Scraper Configuration
WEEB_CENTRAL_ENABLED=true
WEEB_CENTRAL_PRIORITY=1
WEEB_CENTRAL_TIMEOUT=30000

COMIX_ENABLED=true
COMIX_PRIORITY=2
COMIX_TIMEOUT=30000

NHENTAI_ENABLED=true
NHENTAI_PRIORITY=3
NHENTAI_TIMEOUT=30000

MANGADEX_ENABLED=true
MANGADEX_PRIORITY=4
MANGADEX_TIMEOUT=30000

# Monitoring Stack
SENTRY_DSN=

# Contact
CONTACT_EMAIL=contact@doamin
LEGAL_EMAIL=dmca@domain

# Audit log retention in days (default 90)
AUDIT_LOG_RETENTION_DAYS=90
