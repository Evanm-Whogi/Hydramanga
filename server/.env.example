# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/manga_db

# Server Configuration
PORT=4000
NODE_ENV=development

# API Keys
DISCORD_WEBHOOK_URL=
ANILIST_API_URL=https://graphql.anilist.co

# File Storage
UPLOAD_DIR=./uploads

# Redis
REDIS_URL=redis://localhost:6379

# NSFW Content Filter
# Set to false to filter out adult/NSFW content
ALLOW_NSFW_CONTENT=true

# Blocked Genres (comma-separated, case-insensitive)
# These genres will always be filtered out regardless of ALLOW_NSFW_CONTENT setting
BLOCKED_GENRES=Hentai,Lolicon,Shotacon,Erotica,Smut
