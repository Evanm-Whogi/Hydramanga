# Public Site Configuration
PUBLIC_NAME=HydraManga
PUBLIC_DESC=HydraManga gives you total control over how you discover and read. Earn badges, climb the leaderboards, and join a community that never sleeps. Are you ready to read?
PUBLIC_SLOGAN=Unleash your next Obsession.
PUBLIC_APP_URL=https://yourdomain.com
PUBLIC_VERSION=B-1.5
PORT=4000 # Backend Port

# Notifications (set ENABLE_DISCORD_NOTIFICATIONS=true to send)
ENABLE_DISCORD_NOTIFICATIONS=false
DISCORD_PUBLIC_WEBHOOK_URL=
DISCORD_ADMIN_WEBHOOK_URL=
# Legacy fallback — used for both channels if the URLs above are unset
DISCORD_WEBHOOK_URL=

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5433/mangaScrolls
DB_POOL_MAX=75
DB_POOL_CONNECTION_TIMEOUT_MS=60000

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
RUN_WORKERS=false

# Authentication Configuration
# Comma-separated emails promoted to admin on registration (optional; no auto first-user admin)
BOOTSTRAP_ADMIN_EMAILS=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001 # This MUST be the backend's own URL
BETTER_AUTH_SECURE_COOKIES=true # Set to true in production with HTTPS

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Queues & Crons
ENABLE_IMPORT_CRON=true # Set to true to enable the manga import cron job
CHAPTER_SCAN_CONCURRENCY=1 # how many mangas to scan for new chapters at once
CHAPTER_SCAN_RATE_MAX=1   # Max chapter-scan jobs started per CHAPTER_SCAN_RATE_DURATION window
CHAPTER_SCAN_RATE_DURATION=5000  # ms between scan starts (spaces burst ranked/catalog scans; raises to ease scraper bans)
STORAGE_CLEANUP_CONCURRENCY=1           # Background chapter file deletion jobs
TRENDING_SCAN_SCHEDULE=0 2,14 * * *      # 2 AM and 2 PM
MONITORED_SCAN_SCHEDULE=0 6,18 * * *     # 6 AM and 6 PM (3.5 hour buffer)
TRENDING_LIMIT=250 # How many mangas to consider for trending fetching

# NSFW Content Filters
ALLOW_NSFW_CONTENT=true
BLOCKED_GENRES=Hentai,Lolicon,Shotacon,Erotica,Smut

# Queue Concurrency
# Each scraper has its own chapter download queue (chapterDownload-{scraperId}).
# Per-scraper vars override the defaults below; unset scrapers inherit CHAPTER_DOWNLOAD_CONCURRENCY / CHAPTER_DOWNLOAD_RATE_MAX.
# Shared chapter download defaults
CHAPTER_DOWNLOAD_CONCURRENCY=4          # Fallback when a scraper-specific value is not set
CHAPTER_DOWNLOAD_RATE_MAX=4             # Max jobs started per rate window (global fallback)
CHAPTER_DOWNLOAD_RATE_DURATION=1000     # Rate window in ms
CHAPTER_DOWNLOAD_TIMEOUT=900000         # 15 minutes per chapter job
CHAPTER_DOWNLOAD_RETRIES=2              # How many times to retry a job if it fails
CHAPTER_PREVIEW_COUNT=10                # Preview chapters queued first on initial scan
FLARESOLVERR_URL=http://flaresolverr:8191,http://flaresolverr-2:8191
ONISAGA_FLARESOLVERR_URL=http://flaresolverr:8191

# Scraper Configuration
ATSU_MOE_ENABLED=true
ATSU_MOE_PRIORITY=1
ATSU_MOE_TIMEOUT=30000
CHAPTER_DOWNLOAD_ATSUMOE_CONCURRENCY=7
CHAPTER_DOWNLOAD_ATSUMOE_RATE_MAX=7

MANGAGO_ENABLED=true
MANGAGO_PRIORITY=2
MANGAGO_TIMEOUT=30000
CHAPTER_DOWNLOAD_MANGAGO_CONCURRENCY=6
CHAPTER_DOWNLOAD_MANGAGO_RATE_MAX=6

WEEB_CENTRAL_ENABLED=true
WEEB_CENTRAL_PRIORITY=3
WEEB_CENTRAL_TIMEOUT=30000
CHAPTER_DOWNLOAD_WEEBCENTRAL_CONCURRENCY=2 # How many chapter jobs to run at once (CF 429 if higher)
CHAPTER_DOWNLOAD_WEEBCENTRAL_RATE_MAX=2 # Max jobs started per rate window
CHAPTER_DOWNLOAD_WEEBCENTRAL_RATE_DURATION=5000 # Space chapter HTML GETs to avoid CF 429

MANGAFIRE_ENABLED=true
MANGAFIRE_PRIORITY=4
MANGAFIRE_TIMEOUT=30000
CHAPTER_DOWNLOAD_MANGAFIRE_CONCURRENCY=4
CHAPTER_DOWNLOAD_MANGAFIRE_RATE_MAX=4

MANGATARO_ENABLED=true
MANGATARO_PRIORITY=5
MANGATARO_TIMEOUT=30000
CHAPTER_DOWNLOAD_MANGATARO_CONCURRENCY=5
CHAPTER_DOWNLOAD_MANGATARO_RATE_MAX=5

TOONILY_ENABLED=true
TOONILY_PRIORITY=6
TOONILY_TIMEOUT=30000
CHAPTER_DOWNLOAD_TOONILY_CONCURRENCY=4
CHAPTER_DOWNLOAD_TOONILY_RATE_MAX=4

ASURA_COMIC_ENABLED=true
ASURA_COMIC_PRIORITY=7
ASURA_COMIC_TIMEOUT=30000
CHAPTER_DOWNLOAD_ASURACOMIC_CONCURRENCY=4
CHAPTER_DOWNLOAD_ASURACOMIC_RATE_MAX=4

NHENTAI_ENABLED=true
NHENTAI_PRIORITY=8
NHENTAI_TIMEOUT=30000
CHAPTER_DOWNLOAD_NHENTAI_CONCURRENCY=1
CHAPTER_DOWNLOAD_NHENTAI_RATE_MAX=1

# DISABLED SCRAPERS

ONISAGA_ENABLED=false
ONISAGA_PRIORITY=5
ONISAGA_TIMEOUT=30000
CHAPTER_DOWNLOAD_ONISAGA_CONCURRENCY=1
CHAPTER_DOWNLOAD_ONISAGA_RATE_MAX=1

KAGANE_ENABLED=false
KAGANE_PRIORITY=3
KAGANE_TIMEOUT=120000
CHAPTER_DOWNLOAD_KAGANE_CONCURRENCY=7
CHAPTER_DOWNLOAD_KAGANE_RATE_MAX=7

MANGADEX_ENABLED=false
MANGADEX_PRIORITY=9
MANGADEX_TIMEOUT=30000
CHAPTER_DOWNLOAD_MANGADEX_CONCURRENCY=4
CHAPTER_DOWNLOAD_MANGADEX_RATE_MAX=4

COMIX_ENABLED=false
COMIX_PRIORITY=5
COMIX_TIMEOUT=30000
CHAPTER_DOWNLOAD_COMIX_CONCURRENCY=4
CHAPTER_DOWNLOAD_COMIX_RATE_MAX=4

# Monitoring Stack
ENABLE_SENTRY=false
SENTRY_DSN=

# Contact
CONTACT_EMAIL=contact@example.com
LEGAL_EMAIL=dmca@example.com

# Logs
AUDIT_LOG_RETENTION_DAYS=90

# S3
# Public read URLs → the Cloudflare Worker domain (which injects the bucket subdomain +
# public token and fronts MegaS4). Browser never sees the storage host or the token.
S3_PUBLIC_BASE_URL=https://cdn.yourdomain.com/manga
S3_PROFILE_PUBLIC_BASE_URL=https://cdn.yourdomain.com/profile-pictures
S3_STICKER_PUBLIC_BASE_URL=https://cdn.yourdomain.com/stickers

S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

S3_BUCKET_NAME=manga
S3_REGION=us-east-1
S3_MAX_CONCURRENT_UPLOADS=32 # Global cap on concurrent object uploads (PutObject) across all jobs
S3_MAX_SOCKETS=64 # S3 client socket-pool size. Keep above S3_MAX_CONCURRENT_UPLOADS so reads/heads aren't starved behind uploads.

# Torrents
PROWLARR_API_KEY=
PROWLARR_INDEXER_IDS=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Store Timing
STORE_TIMING=0
