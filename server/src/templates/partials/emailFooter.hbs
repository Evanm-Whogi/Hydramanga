<tr>
  <td class="email-footer" style="padding:24px 32px 28px;border-top:1px solid #424242;text-align:center;">
    {{#if appUrl}}
    <p style="margin:0 0 10px;font-size:13px;line-height:1.5;color:#D4D4D4;">
      <a href="{{appUrl}}" style="color:#9370DB;text-decoration:none;font-weight:500;">Visit {{appName}}</a>
    </p>
    {{/if}}
    <p style="margin:0;font-size:12px;line-height:1.5;color:#8A8A8A;">&copy; {{year}} {{appName}}. All rights reserved.</p>
  </td>
</tr>
