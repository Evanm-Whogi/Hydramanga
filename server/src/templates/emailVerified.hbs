<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Email verified</title>
  {{> emailStyles}}
</head>
<body style="margin:0;padding:0;background-color:#161819;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#161819;">
    <tr>
      <td class="email-shell" align="center" style="padding:40px 16px;">
        <table role="presentation" class="email-card" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background-color:#1E2021;border-radius:12px;border:1px solid #424242;overflow:hidden;">
          <tr>
            <td style="height:4px;background-color:#9370DB;font-size:0;line-height:0;">&nbsp;</td>
          </tr>
          {{> emailHeader headline="Email verified"}}
          <tr>
            <td class="email-body" style="padding:0 32px 32px;color:#D4D4D4;font-size:15px;line-height:1.65;">
              <p style="margin:0 0 16px;color:#ffffff;font-size:16px;font-weight:600;">Hi {{username}},</p>
              <p style="margin:0 0 16px;">Your email address has been verified. You are all set to sign in and start using {{appName}}.</p>
              {{#if appUrl}}
              <table role="presentation" cellspacing="0" cellpadding="0" style="margin:0 0 8px;">
                <tr>
                  <td style="border-radius:8px;background-color:#9370DB;">
                    <a href="{{appUrl}}" style="display:inline-block;padding:14px 28px;color:#ffffff;text-decoration:none;font-size:15px;font-weight:600;">Go to {{appName}}</a>
                  </td>
                </tr>
              </table>
              {{/if}}
              <p style="margin:16px 0 0;font-size:14px;color:#8A8A8A;">If you have any questions, reach out through our contact page.</p>
            </td>
          </tr>
          {{> emailFooter}}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
