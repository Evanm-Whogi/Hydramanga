<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Password reset successful</title>
  {{> emailStyles}}
</head>
<body style="margin:0;padding:0;background-color:#161819;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#161819;">
    <tr>
      <td class="email-shell" align="center" style="padding:40px 16px;">
        <table role="presentation" class="email-card" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background-color:#1E2021;border-radius:12px;border:1px solid #424242;overflow:hidden;">
          <tr>
            <td style="height:4px;background-color:#9370DB;font-size:0;line-height:0;">&nbsp;</td>
          </tr>
          {{> emailHeader headline="Password reset successful"}}
          <tr>
            <td class="email-body" style="padding:0 32px 32px;color:#D4D4D4;font-size:15px;line-height:1.65;">
              <p style="margin:0 0 16px;color:#ffffff;font-size:16px;font-weight:600;">Hi {{username}},</p>
              <p style="margin:0 0 16px;">Your password has been updated successfully.</p>
              <p style="margin:0 0 16px;">If you made this change, no further action is needed.</p>
              <p style="margin:0;padding:16px;border-radius:8px;background-color:#161819;border:1px solid #424242;font-size:14px;color:#D4D4D4;">
                If you did not reset your password, contact support immediately so we can help secure your account.
              </p>
            </td>
          </tr>
          {{> emailFooter}}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
