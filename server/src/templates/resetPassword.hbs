<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Reset your password</title>
  {{> emailStyles}}
</head>
<body style="margin:0;padding:0;background-color:#161819;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#161819;">
    <tr>
      <td class="email-shell" align="center" style="padding:40px 16px;">
        <table role="presentation" class="email-card" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background-color:#1E2021;border-radius:12px;border:1px solid #424242;overflow:hidden;">
          <tr>
            <td style="height:4px;background-color:#9370DB;font-size:0;line-height:0;">&nbsp;</td>
          </tr>
          {{> emailHeader headline="Reset your password"}}
          <tr>
            <td class="email-body" style="padding:0 32px 32px;color:#D4D4D4;font-size:15px;line-height:1.65;">
              <p style="margin:0 0 16px;color:#ffffff;font-size:16px;font-weight:600;">Hi {{username}},</p>
              <p style="margin:0 0 20px;">We received a request to reset your password. Click the button below to choose a new one.</p>
              <table role="presentation" cellspacing="0" cellpadding="0" style="margin:0 0 24px;">
                <tr>
                  <td style="border-radius:8px;background-color:#9370DB;">
                    <a href="{{resetLink}}" style="display:inline-block;padding:14px 28px;color:#ffffff;text-decoration:none;font-size:15px;font-weight:600;">Reset password</a>
                  </td>
                </tr>
              </table>
              <p style="margin:0 0 12px;font-size:14px;color:#8A8A8A;">If the button does not work, copy and paste this link into your browser:</p>
              <p style="margin:0 0 20px;word-break:break-all;">
                <a href="{{resetLink}}" style="color:#9370DB;text-decoration:none;font-size:13px;">{{resetLink}}</a>
              </p>
              <p style="margin:0;font-size:14px;color:#8A8A8A;">If you did not request a password reset, you can safely ignore this email.</p>
            </td>
          </tr>
          {{> emailFooter}}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
