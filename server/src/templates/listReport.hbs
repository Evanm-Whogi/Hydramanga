<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>List report</title>
  {{> emailStyles}}
</head>
<body style="margin:0;padding:0;background-color:#161819;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#161819;">
    <tr>
      <td class="email-shell" align="center" style="padding:40px 16px;">
        <table role="presentation" class="email-card" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background-color:#1E2021;border-radius:12px;border:1px solid #424242;overflow:hidden;">
          <tr>
            <td style="height:4px;background-color:#9370DB;font-size:0;line-height:0;">&nbsp;</td>
          </tr>
          {{> emailHeader headline="List report"}}
          <tr>
            <td class="email-body" style="padding:0 32px 32px;color:#D4D4D4;font-size:15px;line-height:1.65;">
              <p style="margin:0 0 20px;">A curated list issue was reported on {{appName}}.</p>
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:0 0 12px;">
                <tr>
                  <td class="field-card" style="padding:16px;border-radius:8px;background-color:#161819;border:1px solid #424242;">
                    <div style="font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#8A8A8A;margin-bottom:6px;">List ID</div>
                    <div style="font-size:14px;color:#ffffff;">{{listId}}</div>
                  </td>
                </tr>
              </table>
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:0 0 12px;">
                <tr>
                  <td class="field-card" style="padding:16px;border-radius:8px;background-color:#161819;border:1px solid #424242;">
                    <div style="font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#8A8A8A;margin-bottom:6px;">List title</div>
                    <div style="font-size:14px;color:#ffffff;white-space:pre-wrap;">{{listTitle}}</div>
                  </td>
                </tr>
              </table>
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:0 0 12px;">
                <tr>
                  <td class="field-card" style="padding:16px;border-radius:8px;background-color:#161819;border:1px solid #424242;">
                    <div style="font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#8A8A8A;margin-bottom:6px;">Report type</div>
                    <div style="font-size:14px;color:#ffffff;">{{reportTypeLabel}}</div>
                  </td>
                </tr>
              </table>
              {{#if details}}
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:0 0 12px;">
                <tr>
                  <td class="field-card" style="padding:16px;border-radius:8px;background-color:#161819;border:1px solid #424242;">
                    <div style="font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#8A8A8A;margin-bottom:6px;">Details</div>
                    <div style="font-size:14px;color:#ffffff;white-space:pre-wrap;">{{details}}</div>
                  </td>
                </tr>
              </table>
              {{/if}}
              {{#if reporterName}}
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:0 0 12px;">
                <tr>
                  <td class="field-card" style="padding:16px;border-radius:8px;background-color:#161819;border:1px solid #424242;">
                    <div style="font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#8A8A8A;margin-bottom:6px;">Reported by</div>
                    <div style="font-size:14px;color:#ffffff;">{{reporterName}} ({{reporterEmail}})</div>
                  </td>
                </tr>
              </table>
              {{/if}}
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                <tr>
                  <td class="field-card" style="padding:16px;border-radius:8px;background-color:#161819;border:1px solid #424242;">
                    <div style="font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#8A8A8A;margin-bottom:6px;">Request metadata</div>
                    <div style="font-size:13px;color:#D4D4D4;white-space:pre-wrap;">IP: {{ip}} | User-Agent: {{userAgent}}</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {{> emailFooter}}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
